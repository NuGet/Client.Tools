<Project>
  <Target Name="ValidateDotnetPackageSkillsBuild"
          BeforeTargets="Restore;CollectPackageReferences;PrepareForBuild;GetAssemblyVersion;Pack;Sign">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(DotnetPackageSkillsReleaseBuild)', '^(?i:true|false)$'))"
           Text="dotnet-package-skills: DotnetPackageSkillsReleaseBuild must be true or false." />
    <Error Condition="'$(OfficialBuildId)' != '' and '$(_DotnetPackageSkillsValidBuildId)' != 'true'"
           Text="dotnet-package-skills: OfficialBuildId must be a valid yyyyMMdd.r date with a revision from 1 through 99, without leading zeros; Azure's numeric BuildId is not an OfficialBuildId." />
    <Error Condition="'$(OfficialBuildId)' != '' and '$(_DotnetPackageSkillsTrustedBuild)' != 'true'"
           Text="dotnet-package-skills: official builds require CI on main from trusted dnceng/internal/NuGet-Client.Tools, with non-PR build metadata." />
    <Error Condition="'$(DotnetPackageSkillsReleaseBuild)' == 'true' and
        ('$(_DotnetPackageSkillsTrustedBuild)' != 'true' or '$(BUILD_REASON)' != 'Manual')"
           Text="dotnet-package-skills: DotnetPackageSkillsReleaseBuild requires a manual official build on trusted main with all source and version inputs." />
    <Error Condition="'$(DotNetFinalVersionKind)' != '' and
        ('$(DotnetPackageSkillsReleaseBuild)' != 'true' or '$(DotNetFinalVersionKind)' != 'release')"
           Text="dotnet-package-skills: DotNetFinalVersionKind cannot bypass the default-false DotnetPackageSkillsReleaseBuild opt-in." />
    <Error Condition="'$(DotnetPackageSkillsReleaseBuild)' == 'true' and '$(DotNetFinalVersionKind)' != 'release'"
           Text="dotnet-package-skills: DotnetPackageSkillsReleaseBuild must map to Arcade's release version kind." />
    <Error Condition="'$(PackAsTool)' == 'true' and '$(RuntimeIdentifier)' != ''"
           Text="dotnet-package-skills: RuntimeIdentifier must remain empty for portable tools/&lt;tfm&gt;/any packaging." />
    <Error Condition="'$(PackAsTool)' == 'true' and
        (('$(VersionSuffix)' == '' and '$(Version)' != '$(VersionPrefix)') or
         ('$(VersionSuffix)' != '' and '$(Version)' != '$(VersionPrefix)-$(VersionSuffix)') or
         '$(PackageVersion)' != '$(Version)')"
           Text="dotnet-package-skills: Version and PackageVersion must use the same evaluated Arcade version inputs." />
  </Target>

  <Target Name="GetDotnetPackageSkillsBuildMetadata" DependsOnTargets="GetAssemblyVersion">
    <PropertyGroup>
      <DotnetPackageSkillsPackagePath>$(ArtifactsShippingPackagesDir)$(PackageId).$(PackageVersion).nupkg</DotnetPackageSkillsPackagePath>
      <DotnetPackageSkillsBuildOutputPath>$(BaseOutputPath)$(Configuration)</DotnetPackageSkillsBuildOutputPath>
      <DotnetPackageSkillsStrongNameToolPath>$(NuGetPackageRoot)sn\$(SNVersion)\sn.exe</DotnetPackageSkillsStrongNameToolPath>
    </PropertyGroup>
  </Target>

  <Target Name="GetDotnetPackageSkillsSigningInputs" DependsOnTargets="GetDotnetPackageSkillsBuildMetadata"
          Returns="@(_DotnetPackageSkillsSigningInput)">
    <ItemGroup>
      <_DotnetPackageSkillsSigningInput Include="$(DotnetPackageSkillsPackagePath)"
                                      PackagePath="$(DotnetPackageSkillsPackagePath)"
                                      PackageVersion="$(PackageVersion)"
                                      BuildOutputPath="$(DotnetPackageSkillsBuildOutputPath)" />
      <_DotnetPackageSkillsSigningInput Include="$(DotnetPackageSkillsBuildOutputPath)\net8.0\dotnet-package-skills.dll" />
      <_DotnetPackageSkillsSigningInput Include="$(DotnetPackageSkillsBuildOutputPath)\net10.0\dotnet-package-skills.dll" />
    </ItemGroup>
  </Target>
</Project>
